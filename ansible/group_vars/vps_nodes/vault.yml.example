---
# Generated by ansible-vault

# Per-host node bootstrap secrets.
# Keep the real file encrypted and mirror these keys in:
# ansible/inventory/host_vars/<host>.yml
ppanel_node_secret_key: "SECRET_KEY_HERE"

# Optional per-host overrides when a node should not use the group default.
ppanel_node_server_id: 1
ppanel_node_api_host: https://admin-ppanel.panghuli.tech
