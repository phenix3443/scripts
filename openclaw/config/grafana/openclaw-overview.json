        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"openclaw\",container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "OpenClaw pod CPU (cores)",
      "type": "timeseries"
    },
